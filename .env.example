# PostgreSQL connection string (works on Vercel serverless; SQLite does not).
# Local dev via Docker: postgres://postgres:postgres@localhost:5432/stratex
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stratex"

# Session signing secret (HMAC) — REQUIRED in production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Cron endpoint auth (Vercel Cron sends: Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=""

# --- Integrations (not required for the demo) ---
# GoCardless Bank Account Data (PSD2) — auto rent reconciliation / late-payment detection
# GOCARDLESS_SECRET_ID=""
# GOCARDLESS_SECRET_KEY=""
